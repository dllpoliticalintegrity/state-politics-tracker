// Cloudflare Workers deploy config (`npx wrangler deploy`), published by
// .github/workflows/deploy.yml on every push to main. The classic Pages
// flow ignores this file and uses functions/ instead — both share
// shared/seo.ts.
//
// One Worker serves everything: the multi-state hub at its workers.dev
// address, and the dedicated single-state sites (michiganpoliticstracker.com,
// texaspoliticstracker.com, cagovtracker.com) as custom domains attached to
// it in the dashboard. The Worker pins the state from the hostname
// (SINGLE_STATE_HOSTS in shared/site.ts) and injects a <meta name="site-state">
// tag so the SPA agrees. A SITE_STATE var would pin a whole Worker to one
// state instead, for a preview deployment of a single site.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "state-politics-tracker",
  "compatibility_date": "2026-07-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
