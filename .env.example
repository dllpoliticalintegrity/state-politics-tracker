# Supabase project for this site (shared with the TX tracker — see docs/plan.md).
# The app boots without these; data queries only happen once a state is
# "live" in src/states/registry.ts.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Run the SPA as one state's dedicated site (michiganpoliticstracker.com) in
# local dev: a two-letter live-state code, e.g. `mi`. Leave blank for the
# multi-state hub. In production the Worker's SITE_STATE var / the hostname
# decide this — see shared/site.ts and wrangler.jsonc.
VITE_SITE_STATE=
