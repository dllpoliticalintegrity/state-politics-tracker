# Campaign finance daemon — weekly state sync groups.
# Installed via ops/install_cron.sh — do not edit the live crontab by hand,
# edit this file and reinstall so it stays the source of truth.
#
# PATH is set explicitly because cron runs jobs with a minimal environment —
# without this, `aws` (used by daemon.py's ECS restart step) may not resolve.
# Verify this matches your machine: `which aws` (Apple Silicon Homebrew is
# usually /opt/homebrew/bin, Intel Homebrew is /usr/local/bin).
PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin

# 2026-10-03: cut down to the eight states live on the site
# (GA FL AZ AK MI OH TX WI). The previous 24-state schedule is in
# crontab.pre-eight-states-backup-2026-10-03. States not listed here are no
# longer refreshed anywhere, including their R2 copies.
#
# Heavy scrapers (GA FL AZ AK TX WI) get at most one per night. TX and WI
# each have a night to themselves.
#
# Nothing is scheduled on Fridays: the Friday 2am job never started between
# 2026-07-31 and 2026-10-02 although it was installed, cause not yet found.
#
# Output is appended to logs/cron_group{N}.log. Keep it that way: those logs
# are the only record when a job fails before the daemon creates a run folder.
#
# NOTE: cron does not wake a sleeping Mac or catch up missed runs.

# Group 1 — GA MI — Mondays 2am
0 2 * * 1 cd "/Users/henryderyke/projects/state-level campaign finance" && .venv/bin/python3 ops/daemon.py GA MI --live >> logs/cron_group1.log 2>&1

# Group 2 — FL OH — Tuesdays 2am
0 2 * * 2 cd "/Users/henryderyke/projects/state-level campaign finance" && .venv/bin/python3 ops/daemon.py FL OH --live >> logs/cron_group2.log 2>&1

# Group 3 — AZ AK — Wednesdays 2am
0 2 * * 3 cd "/Users/henryderyke/projects/state-level campaign finance" && .venv/bin/python3 ops/daemon.py AZ AK --live >> logs/cron_group3.log 2>&1

# Group 4 — TX — Thursdays 2am
0 2 * * 4 cd "/Users/henryderyke/projects/state-level campaign finance" && .venv/bin/python3 ops/daemon.py TX --live >> logs/cron_group4.log 2>&1

# Group 5 — WI — Saturdays 2am
0 2 * * 6 cd "/Users/henryderyke/projects/state-level campaign finance" && .venv/bin/python3 ops/daemon.py WI --live >> logs/cron_group5.log 2>&1

# Heartbeat — every hour, on the hour. Proves cron itself fired, separately
# from whether the daemon worked: a gap in logs/cron_heartbeat.log means cron
# did not run then (Mac asleep or off). Added 2026-10-03 to explain the
# Friday gap.
0 * * * * cd "/Users/henryderyke/projects/state-level campaign finance" && date "+\%Y-\%m-\%d \%H:\%M \%a" >> logs/cron_heartbeat.log 2>&1

# "Nothing ran" check -- daily 9am, after every 2am run has finished. Emails
# only when a live state has had no new data for more than eight days;
# otherwise one line in logs/nothing_ran_check.log. Added 2026-10-04.
# Changing this file gives every state a fresh eight days before it reports.
0 9 * * * cd "/Users/henryderyke/projects/state-level campaign finance" && .venv/bin/python3 ops/nothing_ran_check.py >> logs/nothing_ran_check.log 2>&1
